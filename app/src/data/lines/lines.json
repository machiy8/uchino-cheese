  {"id": "white_mold-vintage-1", "text": "昔はよく甘えたものね…今もだけど", "types": ["white_mold"], "stages": ["vintage"], "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "pet"]},
  {"id": "blue_mold-vintage-1", "text": "長い付き合いだ。たまには素直に言うか…ありがとな", "types": ["blue_mold"], "stages": ["vintage"], "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
