 "lines": [
  {"id": "fresh-1", "text": "ぼく、まだ生まれたてだよ", "types": ["fresh"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "fresh-2", "text": "ミルクのにおい、すき", "types": ["fresh"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "feed"]},
  {"id": "fresh-3", "text": "なでなでして〜", "types": ["fresh"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "pet"]},
  {"id": "white_mold-1", "text": "ねえねえ、もうちょっとだけなでて", "types": ["white_mold"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "pet"]},
  {"id": "white_mold-2", "text": "ふわふわの毛布、あったかいでしょ", "types": ["white_mold"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "white_mold-3", "text": "中身はとろとろなの、ないしょね", "types": ["white_mold"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "blue_mold-1", "text": "べ、べつに針なんて痛くないし", "types": ["blue_mold"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "care"]},
  {"id": "blue_mold-2", "text": "…来るの遅いぞ", "types": ["blue_mold"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "reunion"]},
  {"id": "blue_mold-3", "text": "青いのは模様だ。かっこいいだろ", "types": ["blue_mold"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "washed-1", "text": "におい？それがオレの魅力さ", "types": ["washed"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "washed-2", "text": "洗ってくれてサンキュー、さっぱりした！", "types": ["washed"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["care"]},
  {"id": "washed-3", "text": "困ったことがあったら言いな", "types": ["washed"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "chevre-1", "text": "今日はひんやりの気分。明日はわかんない", "types": ["chevre"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "sun"]},
  {"id": "chevre-2", "text": "炭のおけしょう、似合う？", "types": ["chevre"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "chevre-3", "text": "つかまえてごらん〜", "types": ["chevre"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "pet"]},
  {"id": "semi_hard-1", "text": "今日もコツコツ熟成中です", "types": ["semi_hard"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "semi_hard-2", "text": "派手じゃないけど、中身はしっかりしてます", "types": ["semi_hard"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "semi_hard-3", "text": "よし、もうひとがんばり", "types": ["semi_hard"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "feed"]},
  {"id": "hard-1", "text": "わしは1年かけて育つんじゃ", "types": ["hard"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "hard-2", "text": "若いもんは急ぎすぎじゃよ", "types": ["hard"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk"]},
  {"id": "hard-3", "text": "ひっくり返してくれんか、腰が…", "types": ["hard"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "care"]},
  {"id": "pasta_filata-1", "text": "みて！こんなにのびる！", "types": ["pasta_filata"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "pet"]},
