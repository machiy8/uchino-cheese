  {"id": "pasta_filata-3", "text": "ぎゅーってして、びよーん", "types": ["pasta_filata"], "stages": "all", "times": "all", "states": ["normal", "happy"], "scenes": ["talk", "pet"]},
  {"id": "fail-1", "text": "どうせぼくなんか失敗作だし…", "types": ["fail"], "stages": "all", "times": "all", "states": ["normal", "sad"], "scenes": ["talk"]},
